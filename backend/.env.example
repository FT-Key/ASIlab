# Puerto del servidor
PORT=4001

# URL de MongoDB. Si esta vacio o no conecta, la API sirve la pseudo-DB de /data/topics.json
MONGODB_URI=mongodb://localhost:27017/administracion_sistemas

# Servir el build del frontend (frontend/dist) desde el backend en un solo puerto.
# 1 = sirve estaticos (produccion) - 0 = solo API (desarrollo)
SERVE_STATIC=1
