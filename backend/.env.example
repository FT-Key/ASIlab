# Puerto del servidor
PORT=4001

# URL de MongoDB. Si esta vacio o no conecta, la API sirve la pseudo-DB de /data/topics.json
MONGODB_URI=mongodb://localhost:27017/administracion_sistemas

# Servir el build del frontend (frontend/dist) desde el backend en un solo puerto.
# 1 = sirve estaticos (produccion) - 0 = solo API (desarrollo)
SERVE_STATIC=1

# Entorno de ejecucion. En 'production' las rutas de escritura (POST/PUT/DELETE)
# quedan bloqueadas salvo que se configure ADMIN_TOKEN.
NODE_ENV=development

# Token requerido para las rutas de escritura de la API (header: x-admin-token).
# Dejar vacio en desarrollo para permitir la administracion local.
# En produccion es OBLIGATORIO: sin este valor la API rechaza toda escritura.
ADMIN_TOKEN=
